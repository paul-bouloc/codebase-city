# Copy to .env for local development. Never commit real secrets.
# The server refuses to start when a required variable is missing.

# Required. Local Postgres started by `just db-up` (see docker-compose.yml).
DATABASE_URL=postgres://codebase_city:codebase_city@localhost:55432/codebase_city

# Optional, with their defaults.
# HOST=127.0.0.1        # 0.0.0.0 in a container
# PORT=8080
# LOG_FORMAT=text       # text or json
# WEB_DIR=web/dist      # the built web app
# RUST_LOG=info,tower_http=info,sqlx=warn

# Optional. A read-only GitHub token for downloading repositories; GitHub is
# used anonymously without it (`just ingest owner/repo` reads it too).
# GITHUB_TOKEN=
